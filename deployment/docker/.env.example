# Housiy DEV environment example.
# Safe template only. Replace every CHANGE_ME value before starting any environment.

# Application
APP_ENV=dev
APP_PORT=8081
APP_BIND=127.0.0.1

# Database
DB_EXPOSED_PORT=3307
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_A_UNIQUE_RANDOM_SECRET
MYSQL_DATABASE=housiy_dev
MYSQL_APP_USER=housiy_dev_app
MYSQL_APP_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_RANDOM_SECRET

# Redis
REDIS_PASSWORD=CHANGE_ME_USE_ANOTHER_RANDOM_SECRET
REDIS_PREFIX=housiy-dev

# Proxy
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADER=X-Forwarded-For

# Rate limiting
RATE_LIMIT_ENABLED=0
RATE_LIMIT_HASH_SALT=CHANGE_ME_USE_A_RANDOM_SALT
RATE_LIMIT_OVERRIDES=

# Cookies
# 0 for direct localhost HTTP; set 1 when serving DEV through HTTPS.
COOKIE_SECURE=0

# WebSocket
WS_ALLOWED_ORIGINS=
WS_HEARTBEAT_POLL_MS=10000
WS_MAX_BUFFERED_BYTES=65536

# Application image
APP_IMAGE_REPO=housiy-app
APP_IMAGE_TAG=latest
REALTIME_IMAGE_REPO=housiy-realtime

# Performance profiling
PERF_LOG_ENABLED=1
PERF_SERVER_TIMING=1
PERF_SLOW_MS=200

# WebSocket gateway limits and command timeout
WS_MAX_PER_ROOM=110
WS_MAX_CONNECTIONS=12000
WS_COMMAND_TIMEOUT_MS=10000
